#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x1ffba6c0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1ff96020 .scope module, "tb_and_gate" "tb_and_gate" 3 4;
 .timescale -9 -12;
v0x1ffddb30_0 .var "a", 0 0;
v0x1ffddc00_0 .var "b", 0 0;
v0x1ffddcd0_0 .net "y", 0 0, L_0x1ffdddd0;  1 drivers
S_0x1ff961b0 .scope module, "U1" "and_gate" 3 8, 4 2 0, S_0x1ff96020;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x1ffdddd0 .functor AND 1, v0x1ffddb30_0, v0x1ffddc00_0, C4<1>, C4<1>;
v0x1ffcd190_0 .net "a", 0 0, v0x1ffddb30_0;  1 drivers
v0x1ffdd920_0 .net "b", 0 0, v0x1ffddc00_0;  1 drivers
v0x1ffdd9e0_0 .net "y", 0 0, L_0x1ffdddd0;  alias, 1 drivers
    .scope S_0x1ff96020;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "and_gate.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1ff96020 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1ffddb30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1ffddc00_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1ffddb30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1ffddc00_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1ffddb30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1ffddc00_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1ffddb30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1ffddc00_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 18 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";
